{
  "name": "stayfinder",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write",
    "format:check": "prettier --check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "test": "tsx --test src/test/*.test.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.1.1",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.72.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "stripe": "^23.1.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "esbuild": "^0.25.12",
    "minimatch": "^11.0.1"
  }
}
